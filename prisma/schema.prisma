// prisma/schema.prisma
// VisionCore — Schema de base de datos

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Roles del sistema ───────────────────────────────────────
enum Role {
  ADMIN // Acceso total
  SUPERVISOR // Ver todo + grabaciones
  OPERATOR // Solo cámaras asignadas en vivo
  AUDITOR // Solo grabaciones asignadas
}

// ─── Usuarios ────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(OPERATOR)
  active       Boolean  @default(true)
  avatarUrl    String?  @db.Text
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 2FA TOTP
  twoFactorEnabled     Boolean @default(false)
  twoFactorSecret      String? @db.Text
  twoFactorBackupCodes String? @db.Text // JSON: hashed recovery codes

  // Seguridad de contraseña
  passwordChangedAt   DateTime?
  passwordHistory     String?   @db.Text // JSON: last 5 bcrypt hashes
  forcePasswordChange Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordResetToken  String?   @db.Text
  passwordResetExpiry DateTime?

  sessions           Session[]
  permissions        UserPermission[]
  auditLogs          AuditLog[]
  viewAccess         CameraViewAccess[]
  featurePermissions UserFeaturePermissions?

  @@map("users")
}

// ─── Sesiones JWT ────────────────────────────────────────────
model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  deviceName   String? // Parsed from User-Agent
  lastUsedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── NVRs Hikvision ──────────────────────────────────────────
model NVR {
  id                       String    @id @default(cuid())
  name                     String    @unique
  model                    String
  serialNumber             String?
  ipAddress                String
  port                     Int       @default(80)
  rtspPort                 Int       @default(554)
  sdkPort                  Int?      @default(8000)
  username                 String
  password                 String // Encriptado con AES
  channels                 Int       @default(16)
  hddCount                 Int       @default(1)
  firmware                 String?
  encodingVersion          String?
  webVersion               String?
  location                 String?
  active                   Boolean   @default(true)
  online                   Boolean   @default(false)
  lastSeen                 DateTime?
  lastRtspOkAt             DateTime?
  lastSyncAt               DateTime?
  lastErrorCode            String?
  lastError                String?
  isapIStatus              String?   @default("unknown") // available | no_permission | unsupported | error | unknown
  recordingProvider        String    @default("ISAPI")
  supportsIsapiRecording   Boolean?
  supportsSdkRecording     Boolean   @default(false)
  recordingCapabilityAt    DateTime?
  recordingCapabilityError String?   @db.Text
  playbackWebUrl           String?
  sdkEnabled               Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  cameras        Camera[]
  hdds           NvrHdd[]
  permissions    UserPermission[]
  channelBackups NvrChannelConfigBackup[]

  @@map("nvrs")
}

// ─── HDDs del NVR ─────────────────────────────────────────────
model NvrHdd {
  id          String    @id @default(cuid())
  nvrId       String
  nvr         NVR       @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  diskNumber  Int
  capacityGb  Float?
  freeGb      Float?
  usedPercent Float?
  status      String?
  type        String?
  property    String?
  process     String?
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([nvrId, diskNumber])
  @@map("nvr_hdds")
}

// ─── Cámaras ─────────────────────────────────────────────────
model Camera {
  id          String  @id @default(cuid())
  nvrId       String
  nvr         NVR     @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  channel     Int // Canal en el NVR (1-64)
  channelCode String? // D1, D2, D3... código visual del NVR
  name        String
  location    String?

  // Info de la cámara IP dentro del NVR
  ipAddress      String? // IP de la cámara IP
  protocol       String? // HIKVISION, ONVIF, RTSP, etc.
  managementPort Int? // Puerto de gestión (8000)
  securityStatus String? // Secure, Non-Secure, etc.

  // Stream config
  preferredStream String  @default("sub") // main | sub
  mainRtspPath    String? // /Streaming/Channels/101
  subRtspPath     String? // /Streaming/Channels/102

  // Video encoding
  mainCodec      String?
  subCodec       String?
  mainResolution String?
  subResolution  String?
  mainFps        Int?
  subFps         Int?
  mainBitrate    Int?
  subBitrate     Int?

  // Diagnóstico RTSP
  rtspMainOk          Boolean?
  rtspSubOk           Boolean?
  lastRtspCheckAt     DateTime?
  lastRtspError       String?
  consecutiveFailures Int       @default(0)

  // Estado de salud del stream
  streamHealthStatus String   @default("UNKNOWN")
  onlineInNvr        Boolean?
  // Marca de tiempo de la última observación física del NVR (InputProxy). Permite
  // aplicar TTL/frescura: un onlineInNvr viejo no debe pesar sobre uno nuevo, y un
  // onlineInNvr=false reciente prevalece sobre éxitos RTSP antiguos (P0).
  onlineInNvrAt      DateTime?
  // Motivo de la última decisión de estado efectivo (diagnóstico/auditoría).
  statusDecisionReason String?

  // ── Configuración de alertas por cámara (TASK 6) ──
  offlineAlertEnabled     Boolean   @default(true)
  streamErrorAlertEnabled Boolean   @default(true)
  offlineConfirmSec       Int       @default(90)   // confirmar CAMERA_OFFLINE tras N segundos
  recoveryConfirmSec      Int       @default(120)  // confirmar recuperación tras N segundos
  offlineSeverity         String    @default("HIGH")
  streamErrorSeverity     String    @default("MEDIUM")
  sendEmailOnOffline      Boolean   @default(true)
  sendEmailOnRecovery     Boolean   @default(true)
  maintenanceMode         Boolean   @default(false)
  maintenanceUntil        DateTime?

  // ── Evidencia REAL del pipeline de streaming (no confiar en rtspMainOk/subOk
  //    indefinidamente) — alimentan la detección de CAMERA_STREAM_ERROR ──
  lastStreamSuccessAt  DateTime?   // éxito REAL verificado (HLS/frames)
  lastStreamStartAcceptedAt DateTime?  // start-stream ACEPTADO (no prueba frames)
  lastStreamFailureAt  DateTime?
  lastMediaMtxReadyAt  DateTime?
  lastHlsSuccessAt     DateTime?
  lastStreamErrorCode  String?

  // Legado / compatibilidad
  rtspUrl    String?
  hlsPath    String?
  ptzEnabled Boolean   @default(false)
  active     Boolean   @default(true)
  online     Boolean   @default(false)
  lastCheck  DateTime?
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  permissions UserPermission[]

  @@unique([nvrId, channel])
  @@map("cameras")
}

// ─── Permisos por usuario ────────────────────────────────────
model UserPermission {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nvrId    String?
  nvr      NVR?    @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  cameraId String?
  camera   Camera? @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  // Permisos base (NVR y cámara)
  canView        Boolean @default(true)
  canPlayback    Boolean @default(false)
  canPtz         Boolean @default(false)
  canHighQuality Boolean @default(false)

  // Permisos NVR granulares
  canViewCameras    Boolean @default(true)
  canViewRecordings Boolean @default(false)
  canManage         Boolean @default(false)
  canEditVideoAudio Boolean @default(false)
  canSync           Boolean @default(false)
  canRevalidate     Boolean @default(false)
  canRestart        Boolean @default(false)

  // Permisos cámara granulares
  canViewLive      Boolean @default(true)
  canDownload      Boolean @default(false)
  canUseMainStream Boolean @default(false)
  canUseTranscode  Boolean @default(false)
  canAddToViews    Boolean @default(false)
  canReceiveAlerts Boolean @default(false)

  @@unique([userId, nvrId, cameraId])
  @@index([nvrId])
  @@index([cameraId])
  @@map("user_permissions")
}

// ─── Permisos de funcionalidades ─────────────────────────────
model UserFeaturePermissions {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Módulos de interfaz
  canViewDashboard   Boolean @default(true)
  canViewLive        Boolean @default(true)
  canViewRecordings  Boolean @default(false)
  canViewAlerts      Boolean @default(true)
  canViewDiagnostics Boolean @default(false)

  // Administración
  canManageNVRs       Boolean @default(false)
  canManageCameras    Boolean @default(false)
  canManageUsers      Boolean @default(false)
  canManageAppearance Boolean @default(false)

  // Acciones
  canResolveAlerts      Boolean @default(false)
  canRestartStreams     Boolean @default(false)
  canTranscode          Boolean @default(false)
  canDownloadRecordings Boolean @default(false)
  canManageViews        Boolean @default(false)
  canManageSettings     Boolean @default(false)

  @@map("user_feature_permissions")
}

// ─── Log de auditoría ────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String?
  detail    Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Alertas ─────────────────────────────────────────────────
model Alert {
  id         String        @id @default(cuid())
  nvrId      String?
  cameraId   String?
  type       AlertType
  severity   AlertSeverity @default(LOW)
  message    String
  detail     Json?
  resolved   Boolean       @default(false)
  resolvedAt DateTime?
  readAt     DateTime?
  createdAt  DateTime      @default(now())

  @@index([resolved, readAt])
  @@index([nvrId, type, resolved])
  @@index([cameraId, type, resolved])
  @@index([createdAt])
  @@map("alerts")
}

enum AlertType {
  CAMERA_OFFLINE
  NVR_OFFLINE
  HDD_FULL
  HDD_ERROR
  MOTION_DETECTED
  RECORDING_ERROR
  AUTH_FAILED
  PERSON_DETECTED
  VEHICLE_DETECTED
  ZONE_INTRUSION
  LINE_CROSSING
  LOITERING
  OCCUPANCY_LIMIT
  // Salud de cámara (TASK 3/4): señal física vs pipeline de streaming.
  CAMERA_RECOVERED
  CAMERA_STREAM_ERROR
  CAMERA_STREAM_RECOVERED
  STREAM_DEGRADED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Vistas personalizadas de cámaras ────────────────────────
model CameraView {
  id                String   @id @default(cuid())
  name              String
  description       String?
  layout            String   @default("3x3")
  cameraSlots       Json
  slideshowEnabled  Boolean  @default(false)
  slideshowInterval Int      @default(10)
  isPublic          Boolean  @default(false)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  access CameraViewAccess[]

  @@map("camera_views")
}

model CameraViewAccess {
  id        String     @id @default(cuid())
  viewId    String
  view      CameraView @relation(fields: [viewId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([viewId, userId])
  @@index([userId])
  @@map("camera_view_access")
}

// ─── Configuración de apariencia ─────────────────────────────
model AppearanceSettings {
  id                String   @id @default("singleton")
  siteName          String   @default("VisionCore")
  logoText          String   @default("VisionCore")
  primaryColor      String   @default("#e51d1d")
  accentColor       String   @default("#c41616")
  theme             String   @default("dark")
  sidebarWidth      String   @default("normal")
  showNVRsInSidebar Boolean  @default(true)
  customCss         String?  @db.Text
  logoUrl           String?  @db.Text
  sidebarLogoUrl    String?  @db.Text
  faviconUrl        String?  @db.Text
  updatedAt         DateTime @updatedAt

  @@map("appearance_settings")
}

// ─── Entregas de notificaciones ──────────────────────────────
model NotificationDelivery {
  id        String    @id @default(cuid())
  alertId   String
  channel   String // email | websocket | telegram | whatsapp
  status    String // sent | failed | skipped | pending
  recipient String?
  error     String?   @db.Text
  attempts  Int       @default(1)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ── Historial de entregas completo (P1): fecha/hora reales para enviados Y
  //    fallidos, sin depender de sentAt. Denormalizado desde la alerta al crear
  //    la entrega (la alerta puede eliminarse por retención). ──
  attemptedAt DateTime?   // cuándo se intentó el envío
  failedAt    DateTime?   // cuándo falló (los fallidos ya no dependen de sentAt)
  errorCode   String?     // código del error SMTP (p.ej. EAUTH, ECONNECTION)
  subject     String?     // asunto del correo
  alertType   String?     // tipo de alerta (CAMERA_OFFLINE, …)
  cameraName  String?
  nvrName     String?

  @@index([alertId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

// ─── Backup de configuración de canales NVR ─────────────────
model NvrChannelConfigBackup {
  id              String   @id @default(cuid())
  nvrId           String
  cameraId        String?
  channelNo       Int
  streamType      String // 'main' | 'sub' | 'both'
  configJson      String   @db.Text
  createdByUserId String
  createdAt       DateTime @default(now())
  reason          String // 'before_edit' | 'manual' | 'restore'
  nvr             NVR      @relation(fields: [nvrId], references: [id], onDelete: Cascade)

  @@index([nvrId, channelNo, streamType, createdAt])
  @@map("nvr_channel_config_backups")
}

// ─── Analítica de video (Roboflow Supervision) ───────────────
model CameraAnalyticsConfig {
  id            String   @id @default(cuid())
  cameraId      String   @unique
  enabled       Boolean  @default(false)
  // Clases COCO a detectar: ["person","car","truck","bus","motorcycle","bicycle"]
  classes       Json     @default("[\"person\"]")
  minConfidence Float    @default(0.5)
  sampleFps     Float    @default(2)
  // Zonas de intrusión: [{ name, points: [[x,y]...] normalizados 0-1, classes? }]
  zones         Json?
  // Líneas de conteo: [{ name, start: [x,y], end: [x,y] normalizados 0-1, classes? }]
  lines         Json?
  // Config de alertas por tipo de evento:
  // { person: { generateAlert, sendEmail, severity, cooldownSec }, ... }
  alertConfig   Json?
  // Segundos mínimos entre alertas repetidas de la misma clase/zona
  cooldownSec   Int      @default(60)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("camera_analytics_configs")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  cameraId    String
  type        String // person | vehicle | zone_intrusion | line_crossing
  className   String // clase COCO detectada
  confidence  Float
  trackId     Int?
  zoneName    String? // nombre de zona o de línea de conteo
  direction   String? // in | out (solo line_crossing)
  incidentId  String? // correlaciona entrada/permanencia/salida de un incidente de zona
  // Cajas detectadas: [[x1,y1,x2,y2,conf,"clase"], ...] en píxeles del frame
  bboxes      Json?
  snapshotUrl String?
  alertId     String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([cameraId, occurredAt])
  @@index([type, occurredAt])
  @@index([occurredAt])
  @@index([className, occurredAt])
  @@index([zoneName, occurredAt])
  @@index([direction, occurredAt])
  @@index([incidentId])
  @@map("analytics_events")
}

// ─── ALPR: lecturas de matrículas (feature flag ANALYTICS_ALPR_ENABLED) ──
model LicensePlateEvent {
  id                   String   @id @default(cuid())
  cameraId             String
  plateText            String
  plateConfidence      Float
  plateCropSnapshotUrl String?
  fullSnapshotUrl      String?
  occurredAt           DateTime
  createdAt            DateTime @default(now())

  @@index([plateText])
  @@index([cameraId, occurredAt])
  @@index([occurredAt])
  @@map("license_plate_events")
}

// ─── Configuración de alertas y correo ───────────────────────
model SecuritySettings {
  id                     String   @id @default("singleton")
  passwordMinLength      Int      @default(12)
  requireStrongPassword  Boolean  @default(true)
  sessionTimeoutMinutes  Int      @default(60)   // TTL del access token
  maxSessions            Int      @default(5)    // sesiones concurrentes por usuario
  lockoutMaxAttempts     Int      @default(5)
  lockoutDurationMinutes Int      @default(15)
  // Política MFA — persistida ahora; su enforcement llega en la fase siguiente.
  mfaRequired            Boolean  @default(false)
  mfaGracePeriodLogins   Int      @default(3)
  updatedAt              DateTime @updatedAt
  updatedBy              String?

  @@map("security_settings")
}

model AlertSettings {
  id              String   @id @default("singleton")
  emailEnabled    Boolean  @default(false)
  smtpHost        String   @default("")
  smtpPort        Int      @default(587)
  smtpSecure      Boolean  @default(false)
  smtpUser        String   @default("")
  smtpPassword    String   @default("")
  smtpFromEmail   String   @default("")
  smtpFromName    String   @default("VisionCore Alertas")
  recipientEmails String   @default("")
  alertTypes      Json     @default("{\"CAMERA_OFFLINE\":true,\"NVR_OFFLINE\":true,\"HDD_FULL\":true,\"HDD_ERROR\":true,\"MOTION_DETECTED\":false,\"RECORDING_ERROR\":true,\"AUTH_FAILED\":false}")
  minSeverity     String   @default("HIGH")
  updatedAt       DateTime @updatedAt

  @@map("alert_settings")
}
