// prisma/schema.prisma
// VisionCore — Schema de base de datos

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Roles del sistema ───────────────────────────────────────
enum Role {
  ADMIN      // Acceso total
  SUPERVISOR // Ver todo + grabaciones
  OPERATOR   // Solo cámaras asignadas en vivo
  AUDITOR    // Solo grabaciones asignadas
}

// ─── Usuarios ────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(OPERATOR)
  active       Boolean  @default(true)
  avatarUrl    String?  @db.Text
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  permissions  UserPermission[]
  auditLogs    AuditLog[]
  viewAccess   CameraViewAccess[]

  @@map("users")
}

// ─── Sesiones JWT ────────────────────────────────────────────
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("sessions")
}

// ─── NVRs Hikvision ──────────────────────────────────────────
model NVR {
  id             String    @id @default(cuid())
  name           String    @unique
  model          String
  serialNumber   String?
  ipAddress      String
  port           Int       @default(80)
  rtspPort       Int       @default(554)
  sdkPort        Int?      @default(8000)
  username       String
  password       String    // Encriptado con AES
  channels       Int       @default(16)
  hddCount       Int       @default(1)
  firmware       String?
  encodingVersion String?
  webVersion     String?
  location       String?
  active         Boolean   @default(true)
  online         Boolean   @default(false)
  lastSeen       DateTime?
  lastRtspOkAt   DateTime?
  lastSyncAt     DateTime?
  lastErrorCode  String?
  lastError      String?
  isapIStatus    String?  @default("unknown") // available | no_permission | unsupported | error | unknown
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cameras        Camera[]
  hdds           NvrHdd[]
  permissions    UserPermission[]

  @@map("nvrs")
}

// ─── HDDs del NVR ─────────────────────────────────────────────
model NvrHdd {
  id          String   @id @default(cuid())
  nvrId       String
  nvr         NVR      @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  diskNumber  Int
  capacityGb  Float?
  freeGb      Float?
  usedPercent Float?
  status      String?
  type        String?
  property    String?
  process     String?
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([nvrId, diskNumber])
  @@map("nvr_hdds")
}

// ─── Cámaras ─────────────────────────────────────────────────
model Camera {
  id                  String    @id @default(cuid())
  nvrId               String
  nvr                 NVR       @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  channel             Int       // Canal en el NVR (1-64)
  channelCode         String?   // D1, D2, D3... código visual del NVR
  name                String
  location            String?

  // Info de la cámara IP dentro del NVR
  ipAddress           String?   // IP de la cámara IP
  protocol            String?   // HIKVISION, ONVIF, RTSP, etc.
  managementPort      Int?      // Puerto de gestión (8000)
  securityStatus      String?   // Secure, Non-Secure, etc.

  // Stream config
  preferredStream     String    @default("sub") // main | sub
  mainRtspPath        String?   // /Streaming/Channels/101
  subRtspPath         String?   // /Streaming/Channels/102

  // Video encoding
  mainCodec           String?
  subCodec            String?
  mainResolution      String?
  subResolution       String?
  mainFps             Int?
  subFps              Int?
  mainBitrate         Int?
  subBitrate          Int?

  // Diagnóstico RTSP
  rtspMainOk          Boolean?
  rtspSubOk           Boolean?
  lastRtspCheckAt     DateTime?
  lastRtspError       String?
  consecutiveFailures Int       @default(0)

  // Estado de salud del stream
  streamHealthStatus  String    @default("UNKNOWN")
  onlineInNvr         Boolean?

  // Legado / compatibilidad
  rtspUrl     String?
  hlsPath     String?
  ptzEnabled  Boolean  @default(false)
  active      Boolean  @default(true)
  online      Boolean  @default(false)
  lastCheck   DateTime?
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions UserPermission[]

  @@unique([nvrId, channel])
  @@map("cameras")
}

// ─── Permisos por usuario ────────────────────────────────────
model UserPermission {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nvrId       String?
  nvr         NVR?    @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  cameraId    String?
  camera      Camera? @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  canView     Boolean @default(true)
  canPlayback Boolean @default(false)
  canPtz      Boolean @default(false)

  @@unique([userId, nvrId, cameraId])
  @@map("user_permissions")
}

// ─── Log de auditoría ────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String?
  detail    Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ─── Alertas ─────────────────────────────────────────────────
model Alert {
  id         String        @id @default(cuid())
  nvrId      String?
  cameraId   String?
  type       AlertType
  severity   AlertSeverity @default(LOW)
  message    String
  detail     Json?
  resolved   Boolean       @default(false)
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@map("alerts")
}

enum AlertType {
  CAMERA_OFFLINE
  NVR_OFFLINE
  HDD_FULL
  HDD_ERROR
  MOTION_DETECTED
  RECORDING_ERROR
  AUTH_FAILED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Vistas personalizadas de cámaras ────────────────────────
model CameraView {
  id               String   @id @default(cuid())
  name             String
  description      String?
  layout           String   @default("3x3")
  cameraSlots      Json
  slideshowEnabled Boolean  @default(false)
  slideshowInterval Int     @default(10)
  isPublic         Boolean  @default(false)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  access      CameraViewAccess[]

  @@map("camera_views")
}

model CameraViewAccess {
  id        String     @id @default(cuid())
  viewId    String
  view      CameraView @relation(fields: [viewId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([viewId, userId])
  @@map("camera_view_access")
}

// ─── Configuración de apariencia ─────────────────────────────
model AppearanceSettings {
  id                String  @id @default("singleton")
  siteName          String  @default("VisionCore")
  logoText          String  @default("VisionCore")
  primaryColor      String  @default("#e51d1d")
  accentColor       String  @default("#c41616")
  theme             String  @default("dark")
  sidebarWidth      String  @default("normal")
  showNVRsInSidebar Boolean @default(true)
  customCss         String? @db.Text
  updatedAt         DateTime @updatedAt

  @@map("appearance_settings")
}

// ─── Entregas de notificaciones ──────────────────────────────
model NotificationDelivery {
  id        String    @id @default(cuid())
  alertId   String
  channel   String    // email | websocket | telegram | whatsapp
  status    String    // sent | failed | skipped | pending
  recipient String?
  error     String?   @db.Text
  attempts  Int       @default(1)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([alertId])
  @@map("notification_deliveries")
}

// ─── Configuración de alertas y correo ───────────────────────
model AlertSettings {
  id              String  @id @default("singleton")
  emailEnabled    Boolean @default(false)
  smtpHost        String  @default("")
  smtpPort        Int     @default(587)
  smtpSecure      Boolean @default(false)
  smtpUser        String  @default("")
  smtpPassword    String  @default("")
  smtpFromEmail   String  @default("")
  smtpFromName    String  @default("VisionCore Alertas")
  recipientEmails String  @default("")
  alertTypes      Json    @default("{\"CAMERA_OFFLINE\":true,\"NVR_OFFLINE\":true,\"HDD_FULL\":true,\"HDD_ERROR\":true,\"MOTION_DETECTED\":false,\"RECORDING_ERROR\":true,\"AUTH_FAILED\":false}")
  minSeverity     String  @default("HIGH")
  updatedAt       DateTime @updatedAt

  @@map("alert_settings")
}
