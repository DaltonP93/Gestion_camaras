# ─── VisionCore — Variables de entorno ───────────────────────
# Copiar a .env y completar con valores reales

# JWT — generar con: openssl rand -hex 64
JWT_SECRET=cambiar_por_clave_segura_minimo_32_caracteres
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# Clave para cifrado AES de credenciales NVR en la base de datos.
# Si no se define, se usa JWT_SECRET como fallback.
# IMPORTANTE: si se cambia esta clave en una instalación existente,
# las credenciales guardadas deben re-ingresarse manualmente.
# Generar con: openssl rand -hex 32
NVR_CREDENTIAL_KEY=

# CORS — orígenes permitidos separados por coma.
# Dejar vacío para permitir cualquier origen (solo en desarrollo).
# Ejemplo: https://camaras.ejemplo.com,https://otro.ejemplo.com
CORS_ORIGINS=

# Cookies — poner true solo si el sitio tiene HTTPS configurado
# Si el sitio es HTTP y esto es true, las cookies no se envían y el login falla
COOKIE_SECURE=false

# API
API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=production

# ── Analítica de video (Supervision + YOLOX) ─────────────────
# Secreto compartido entre API y servicio analytics: openssl rand -hex 32
# Vacío = analítica deshabilitada
ANALYTICS_SECRET=

# ── Retención de datos (días; 0 desactiva la purga) ──────────
ALERTS_RETENTION_DAYS=90
DELIVERIES_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
ANALYTICS_RETENTION_DAYS=30

# ── Audio en preview de grabaciones (1=on, 0=off) ────────────
RECORDINGS_PREVIEW_AUDIO=1

# ── Watchdogs del preview de grabaciones ─────────────────────
# Timeout de PRIMER BYTE por variante RTSP: si FFmpeg no emite datos en este
# plazo (NVR acepta el socket pero no envía video ni cierra), se lo mata y se
# prueba la siguiente variante. Evita que un FFmpeg colgado bloquee el fallback.
RECORDINGS_PREVIEW_FIRST_BYTE_TIMEOUT_MS=25000
# Gracia tras SIGTERM antes de SIGKILL a un FFmpeg que ignora la señal.
RECORDINGS_PREVIEW_KILL_GRACE_MS=2000
# Espera de la salida REAL de FFmpeg antes de declarar la terminacion atascada.
# Se eleva automaticamente si es menor que KILL_GRACE + EXIT_CONFIRMATION_MARGIN
# (se registra recordings_termination_wait_clamped al arrancar).
RECORDINGS_TERMINATION_WAIT_MS=12000
# Margen para recibir exit/close, drenar stdio y actualizar aliveCount.
RECORDINGS_EXIT_CONFIRMATION_MARGIN_MS=3000
# Plazo para que una reserva de capacidad concedida abra su GET /stream.
RECORDINGS_UNCONSUMED_LEASE_MS=45000
# Duracion de la reduccion temporal de capacidad tras un 453 del NVR.
RECORDINGS_NVR_CAPACITY_COOLDOWN_MS=120000
# Piso del presupuesto TOTAL de arranque (headroom mínimo aunque haya pocos intentos).
RECORDINGS_PREVIEW_TOTAL_STARTUP_MS=60000
# Retardo entre el fallo de una variante y el arranque de la siguiente. El
# presupuesto total lo reserva para no comprimir los últimos intentos.
RECORDINGS_PREVIEW_RETRY_DELAY_MS=800
# Margen de seguridad del presupuesto total para overhead no modelado (spawn, demux).
RECORDINGS_PREVIEW_BUDGET_SAFETY_MARGIN_MS=3000
# Tope duro del presupuesto total. Cada intento recibe el watchdog COMPLETO; si el
# plan no cabe bajo este tope, se recortan las variantes de menor prioridad (y se
# registran con strategy_skipped reason=budget). El total escala con el nº de intentos.
RECORDINGS_PREVIEW_STARTUP_HARD_CAP_MS=120000
# TTL del marcaje "NVR sin soporte de substream" antes de reintentar (ms).
RECORDINGS_NVR_SUBSTREAM_TTL_MS=21600000

# ── Analítica: observabilidad y arquitectura de streams ──────
# URL interna del servicio analytics (proxy de status/frames)
ANALYTICS_URL=http://analytics:8500
# RTSP de MediaMTX visto desde el contenedor analytics (restream compartido)
ANALYTICS_MEDIAMTX_RTSP=rtsp://mediamtx:8554
# ALPR (lectura de matrículas) — scaffold, requiere modelo dedicado
ANALYTICS_ALPR_ENABLED=false
# Fallback RTSP directo al NVR para analytics (default false = solo MediaMTX)
ANALYTICS_ALLOW_DIRECT_RTSP=false

# ── Analítica: provider y módulos avanzados ──────────────────
# Provider de detección: yolox_onnx (real) o mock (sin modelo)
ANALYTICS_PROVIDER=yolox_onnx
# Detección de caídas (requiere modelo de pose compatible; ver docs)
ANALYTICS_FALL_DETECTION_ENABLED=false
# Límite de workers de analítica concurrentes
ANALYTICS_MAX_WORKERS=16

# ── Analítica: ingestor de Frigate (fuente externa de detección) ──
# Frigate SUSTITUYE la detección nativa (YOLOX) y reutiliza el mismo POST interno.
# Con FRIGATE_ENABLED=false el ingestor NO arranca ⇒ comportamiento idéntico.
# Ver docs/frigate/INTEGRATION_DESIGN.md. El servicio Frigate y su despliegue en
# docker-compose son un paso aparte que requiere autorización.
FRIGATE_ENABLED=false
# API HTTP de Frigate (red interna). NUNCA versionar una IP/host real.
FRIGATE_URL=http://frigate:5000
# Transporte de ingesta: http (polling, default, sin broker) | mqtt (tiempo real)
FRIGATE_INGEST_MODE=http
# Intervalo de polling en modo http (segundos)
FRIGATE_POLL_INTERVAL_SEC=5
# MQTT (solo modo mqtt). Requiere instalar paho-mqtt aparte (no está en
# requirements.txt para no arriesgar el gate de licencias).
FRIGATE_MQTT_HOST=
FRIGATE_MQTT_PORT=1883
FRIGATE_MQTT_TOPIC=frigate/events
# Mapa opcional cámara-Frigate → cameraId VisionCore, JSON. Vacío = match directo
# por nombre. Necesario para la exclusión mutua con los workers YOLOX nativos.
FRIGATE_CAMERA_MAP=
# Descargar el snapshot del evento (base64) para adjuntarlo al POST
FRIGATE_FETCH_SNAPSHOTS=true
# Confianza mínima para ingestar un evento
FRIGATE_MIN_CONFIDENCE=0.6
# Clases soportadas (CSV; deben coincidir con las clases del API)
FRIGATE_SUPPORTED_CLASSES=person,car,truck,bus,motorcycle,bicycle

# ── Sesiones de LiveView: vigencia y liberación de FFmpeg ────
# TTL de una sesión de streaming sin heartbeat de CLIENTE, en segundos. Es el
# único criterio de vigencia: ni el proceso FFmpeg vivo ni la actividad de medio
# prolongan una sesión (antes sí lo hacían, y una sesión llegó a sobrevivir 26 h
# renovada por el propio limpiador).
# Rango efectivo 15..3600; un valor fuera de rango se acota y se registra en el
# log `stream_session_ttl_resolved`.
STREAM_IDLE_TIMEOUT=90
# TTL de las sesiones HD/transcodificadas (main_h264) con la pestaña en segundo
# plano, en segundos. Si no se define, hereda STREAM_IDLE_TIMEOUT.
# Con la pestaña oculta el frontend SUSPENDE el heartbeat: pasado este plazo la
# sesión expira y se libera su FFmpeg. Al volver antes del plazo la sesión se
# conserva; al volver después, se pide alta calidad UNA vez y mientras tanto
# sigue reproduciéndose la baja calidad.
STREAM_HD_IDLE_TIMEOUT=90

# ── Salud de cámaras: detección de CAMERA_STREAM_ERROR ───────
# Ventana de demanda: un start-stream fallido dentro de esta ventana cuenta como
# "alguien pidió video y el pipeline no lo entregó" (evidencia de fallo real).
CAMERA_STREAM_DEMAND_WINDOW_MS=600000
# Sondas HLS activas por ciclo del health worker (cada sonda a un path on-demand
# dispara UNA conexión RTSP al NVR — acotado para no barrer las 144 cámaras).
CAMERA_STREAM_HLS_PROBE_MAX_PER_CYCLE=3
# Timeout de cada sonda HLS (ms).
CAMERA_STREAM_HLS_PROBE_TIMEOUT_MS=4000
# Alertas STREAM_DEGRADED (sub caído, fallback main entregando). Opcional: off por
# defecto — el estado degradado siempre se registra en logs igual.
CAMERA_STREAM_DEGRADED_ALERTS=false
# Comprobaciones consecutivas para confirmar caída física / error de pipeline.
CAMERA_OFFLINE_CONFIRM_CHECKS=3
CAMERA_STREAM_ERROR_CONFIRM_CHECKS=3

# ── Reproducción nativa (C22) — TODO apagado por defecto ─────
# Habilita el contrato de negociación explícito y el endpoint de grants de
# medios. Con esto apagado, el comportamiento es idéntico a C21.
NATIVE_PLAYBACK_ENABLED=false
# Habilita EMITIR grants de transporte relay (rtsps/whep) y el endpoint interno
# de validación. Debe permanecer en false mientras MediaMTX acepte `user: any`:
# no se abre el puerto de medios sin auth por path (ver ADR-0001 y threat model).
NATIVE_MEDIA_RELAY_ENABLED=false
# Secreto compartido con el futuro relay autenticado (validación timing-safe).
MEDIA_RELAY_SECRET=
# TTL de un grant de medios en ms (acotado 5000..300000; default 30000).
MEDIA_GRANT_TTL_MS=30000
# N1 — Reconciliación del lifecycle de fuente MediaMTX → registro de instancia del
# plano de grants (sólo LEE /v3/paths/list). Con esto apagado ningún path se
# registra ⇒ `issue` se niega (NO_MEDIA_INSTANCE) ⇒ idéntico a C22.2.
NATIVE_SOURCE_LIFECYCLE_ENABLED=false
# Intervalo del reconcile en ms (default 30000; refresca instancias antes del TTL).
NATIVE_SOURCE_LIFECYCLE_INTERVAL_MS=30000
# N2d — Sesión de medios única por usuario (multi-dispositivo): al emitir un grant
# en un dispositivo nuevo, revoca los grants de la sesión previa del usuario. OFF
# por defecto ⇒ register es no-op ⇒ idéntico a C22.2. (Mapa usuario→sesión en
# proceso: detección de sesión previa best-effort por worker; la revocación sí es
# durable vía índice.)
SINGLE_ACTIVE_MEDIA_SESSION=false
# Habilita el pipeline de eventos de IA (cola/backpressure/circuit-breaker) y la
# ruta de demostración con eventos deterministas. Sin modelo productivo.
AI_EVENTS_ENABLED=false

# ── Observabilidad ───────────────────────────────────────────
# Token para /metrics (si vacío, /metrics queda abierto = asumir red interna)
METRICS_TOKEN=
