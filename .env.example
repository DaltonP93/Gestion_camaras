# ─── VisionCore — Variables de entorno ───────────────────────
# Copiar a .env y completar con valores reales

# JWT — generar con: openssl rand -hex 64
JWT_SECRET=cambiar_por_clave_segura_minimo_32_caracteres
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — orígenes permitidos (separados por coma)
# Dejar vacío para permitir cualquier origen en desarrollo
CORS_ORIGINS=

# API
API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=production

# Clave para cifrado de credenciales NVR (usa el mismo JWT_SECRET o una clave distinta)
# Si se cambia, las credenciales guardadas deben re-ingresarse
NVR_CREDENTIAL_KEY=
