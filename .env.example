# ─── VisionCore — Variables de entorno ───────────────────────
# Copiar a .env y completar con valores reales

# JWT — generar con: openssl rand -hex 64
JWT_SECRET=cambiar_por_clave_segura_minimo_32_caracteres
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# Clave para cifrado AES de credenciales NVR en la base de datos.
# Si no se define, se usa JWT_SECRET como fallback.
# IMPORTANTE: si se cambia esta clave en una instalación existente,
# las credenciales guardadas deben re-ingresarse manualmente.
# Generar con: openssl rand -hex 32
NVR_CREDENTIAL_KEY=

# CORS — orígenes permitidos separados por coma.
# Dejar vacío para permitir cualquier origen (solo en desarrollo).
# Ejemplo: https://camaras.ejemplo.com,https://otro.ejemplo.com
CORS_ORIGINS=

# Cookies — poner true solo si el sitio tiene HTTPS configurado
# Si el sitio es HTTP y esto es true, las cookies no se envían y el login falla
COOKIE_SECURE=false

# API
API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=production

# ── Analítica de video (Supervision + YOLOX) ─────────────────
# Secreto compartido entre API y servicio analytics: openssl rand -hex 32
# Vacío = analítica deshabilitada
ANALYTICS_SECRET=

# ── Retención de datos (días; 0 desactiva la purga) ──────────
ALERTS_RETENTION_DAYS=90
DELIVERIES_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
ANALYTICS_RETENTION_DAYS=30

# ── Audio en preview de grabaciones (1=on, 0=off) ────────────
RECORDINGS_PREVIEW_AUDIO=1
