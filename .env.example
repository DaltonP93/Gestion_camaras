# ─── VisionCore — Variables de entorno ───────────────────────
# Copiar a .env y completar con valores reales

# JWT — generar con: openssl rand -hex 64
JWT_SECRET=cambiar_por_clave_segura_minimo_32_caracteres
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# Clave para cifrado AES de credenciales NVR en la base de datos.
# Si no se define, se usa JWT_SECRET como fallback.
# IMPORTANTE: si se cambia esta clave en una instalación existente,
# las credenciales guardadas deben re-ingresarse manualmente.
# Generar con: openssl rand -hex 32
NVR_CREDENTIAL_KEY=

# CORS — orígenes permitidos separados por coma.
# Dejar vacío para permitir cualquier origen (solo en desarrollo).
# Ejemplo: https://camaras.ejemplo.com,https://otro.ejemplo.com
CORS_ORIGINS=

# Cookies — poner true solo si el sitio tiene HTTPS configurado
# Si el sitio es HTTP y esto es true, las cookies no se envían y el login falla
COOKIE_SECURE=false

# API
API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=production

# ── Analítica de video (Supervision + YOLOX) ─────────────────
# Secreto compartido entre API y servicio analytics: openssl rand -hex 32
# Vacío = analítica deshabilitada
ANALYTICS_SECRET=

# ── Retención de datos (días; 0 desactiva la purga) ──────────
ALERTS_RETENTION_DAYS=90
DELIVERIES_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
ANALYTICS_RETENTION_DAYS=30

# ── Audio en preview de grabaciones (1=on, 0=off) ────────────
RECORDINGS_PREVIEW_AUDIO=1

# ── Watchdogs del preview de grabaciones ─────────────────────
# Timeout de PRIMER BYTE por variante RTSP: si FFmpeg no emite datos en este
# plazo (NVR acepta el socket pero no envía video ni cierra), se lo mata y se
# prueba la siguiente variante. Evita que un FFmpeg colgado bloquee el fallback.
RECORDINGS_PREVIEW_FIRST_BYTE_TIMEOUT_MS=25000
# Gracia tras SIGTERM antes de SIGKILL a un FFmpeg que ignora la señal.
RECORDINGS_PREVIEW_KILL_GRACE_MS=2000
# Piso del presupuesto TOTAL de arranque (headroom mínimo aunque haya pocos intentos).
RECORDINGS_PREVIEW_TOTAL_STARTUP_MS=60000
# Retardo entre el fallo de una variante y el arranque de la siguiente. El
# presupuesto total lo reserva para no comprimir los últimos intentos.
RECORDINGS_PREVIEW_RETRY_DELAY_MS=800
# Margen de seguridad del presupuesto total para overhead no modelado (spawn, demux).
RECORDINGS_PREVIEW_BUDGET_SAFETY_MARGIN_MS=3000
# Tope duro del presupuesto total. Cada intento recibe el watchdog COMPLETO; si el
# plan no cabe bajo este tope, se recortan las variantes de menor prioridad (y se
# registran con strategy_skipped reason=budget). El total escala con el nº de intentos.
RECORDINGS_PREVIEW_STARTUP_HARD_CAP_MS=120000
# TTL del marcaje "NVR sin soporte de substream" antes de reintentar (ms).
RECORDINGS_NVR_SUBSTREAM_TTL_MS=21600000

# ── Analítica: observabilidad y arquitectura de streams ──────
# URL interna del servicio analytics (proxy de status/frames)
ANALYTICS_URL=http://analytics:8500
# RTSP de MediaMTX visto desde el contenedor analytics (restream compartido)
ANALYTICS_MEDIAMTX_RTSP=rtsp://mediamtx:8554
# ALPR (lectura de matrículas) — scaffold, requiere modelo dedicado
ANALYTICS_ALPR_ENABLED=false
# Fallback RTSP directo al NVR para analytics (default false = solo MediaMTX)
ANALYTICS_ALLOW_DIRECT_RTSP=false

# ── Analítica: provider y módulos avanzados ──────────────────
# Provider de detección: yolox_onnx (real) o mock (sin modelo)
ANALYTICS_PROVIDER=yolox_onnx
# Detección de caídas (requiere modelo de pose compatible; ver docs)
ANALYTICS_FALL_DETECTION_ENABLED=false
# Límite de workers de analítica concurrentes
ANALYTICS_MAX_WORKERS=16

# ── Observabilidad ───────────────────────────────────────────
# Token para /metrics (si vacío, /metrics queda abierto = asumir red interna)
METRICS_TOKEN=
