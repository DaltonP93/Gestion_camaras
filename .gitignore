# Dependencies
node_modules/
apps/web/node_modules/
apps/api/node_modules/

# Build output
apps/web/dist/
apps/api/dist/
apps/api/build/

# Environment files — NEVER commit secrets
.env
.env.local
.env.production
.env.staging
apps/api/.env
apps/web/.env
infra/**/.env

# Prisma generated
apps/api/src/generated/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Docker volumes (local dev)
data/
pgdata/

# Temporary
*.tmp
*.bak

# Database backups — never commit to Git
*.sql
backup_*.sql
backup_*.dump
# Allow Prisma migration SQL files
!prisma/migrations/**/*.sql

# Root-level package.json/lock auto-created by "npx prisma generate" from monorepo root
# Real package management lives in apps/api/package.json and apps/web/package.json
/package.json
/package-lock.json
/yarn.lock
.claude/
